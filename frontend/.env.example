# Copy to frontend/.env. Only VITE_ variables reach the browser, so never put secrets here.

# Local development: leave empty. Vite proxies /api to http://localhost:3000 (see vite.config.ts).
# Production: the public URL of the deployed backend.
VITE_API_BASE_URL=

# Price shown on the Pricing page, e.g. "$5". Must match your Stripe price.
VITE_PRO_PRICE=
