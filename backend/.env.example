# Copy to backend/.env and fill in. Never commit the real .env file.

# --- Database (Postgres, e.g. Supabase) ---
DATABASE_URL=
DIRECT_URL=

# --- AI (Groq) ---
GROQ_API_KEY=

# --- Auth ---
# Required in production (the server refuses to start without it).
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Where the frontend runs. Used for CORS, Better-Auth trusted origins and Stripe redirects.
FRONTEND_URL=http://localhost:5173
PORT=3000

# --- Admin ---
# Comma-separated emails that can open /admin (the feedback inbox).
ADMIN_EMAILS=

# --- Billing (Stripe). Optional locally; checkout returns "not configured" without these. ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Citations ---
# Optional contact email sent to Crossref so they can reach you (their "polite pool").
CROSSREF_MAILTO=

# --- Local testing only ---
# Lets POST /api/billing/dev-upgrade flip your plan free/pro without Stripe. Ignored in production.
ALLOW_DEV_UPGRADE=true
